const quizData = rawQuizData.map((item, index) => ({ ...item, displayNo: index + 1 }));
let currentIndex = 0;
let userAnswers = new Array(quizData.length).fill(null);
let isReviewWrongMode = false;
let wrongOrUnansweredIndicesList = [];
let reviewCurrentIdx = 0;

function loadSavedState() {
    const savedAnswers = localStorage.getItem('ssw_quiz_answers_full');
    const savedIndex = localStorage.getItem('ssw_quiz_index_full');
    if (savedAnswers) userAnswers = JSON.parse(savedAnswers);
    if (savedIndex !== null) currentIndex = parseInt(savedIndex, 10);
}
function saveState() {
    localStorage.setItem('ssw_quiz_answers_full', JSON.stringify(userAnswers));
    localStorage.setItem('ssw_quiz_index_full', currentIndex);
}
function updateStats() {
    let answeredCount = 0, scoreCount = 0, wrongOrUnansweredCount = 0;
    userAnswers.forEach((ans, idx) => {
        if (ans !== null) {
            answeredCount++;
            if (ans === quizData[idx].a.toLowerCase()) scoreCount++;
            else wrongOrUnansweredCount++;
        } else wrongOrUnansweredCount++;
    });
    const percent = Math.round((answeredCount / quizData.length) * 100);
    document.getElementById('answered-count').innerText = answeredCount;
    document.getElementById('score').innerText = scoreCount;
    document.getElementById('progress-percent').innerText = `${percent}%`;
    document.getElementById('progress-fill').style.width = `${percent}%`;
    const reviewBtn = document.getElementById('review-wrong-btn');
    if (wrongOrUnansweredCount > 0) {
        document.getElementById('wrong-count-badge').innerText = wrongOrUnansweredCount;
        reviewBtn.style.display = 'inline-block';
    } else reviewBtn.style.display = 'none';
}
function loadQuestion() {
    let activeIndex = isReviewWrongMode ? wrongOrUnansweredIndicesList[reviewCurrentIdx] : currentIndex;
    document.getElementById('current-no').innerText = isReviewWrongMode ? `${reviewCurrentIdx + 1} (Dari ${wrongOrUnansweredIndicesList.length} Soal)` : quizData[activeIndex].displayNo;
    const item = quizData[activeIndex];
    document.getElementById('question-text').innerText = `${item.displayNo}. ${item.q}`;
    const optionsBox = document.getElementById('options-box');
    optionsBox.innerHTML = '';
    const feedbackBox = document.getElementById('feedback-box');
    feedbackBox.style.display = 'none';

    item.o.forEach((optionText) => {
        const optionKey = optionText.trim().charAt(0).toLowerCase();
        const btn = document.createElement('button');
        btn.className = 'option-btn';
        btn.innerText = optionText;
        if (userAnswers[activeIndex] !== null) {
            btn.disabled = true;
            if (optionKey === item.a.toLowerCase()) btn.classList.add('correct');
            if (userAnswers[activeIndex] === optionKey && optionKey !== item.a.toLowerCase()) btn.classList.add('incorrect');
        } else {
            btn.onclick = () => { userAnswers[activeIndex] = optionKey; loadQuestion(); };
        }
        optionsBox.appendChild(btn);
    });

    if (userAnswers[activeIndex] !== null) {
        feedbackBox.style.display = 'block';
        if (userAnswers[activeIndex] === item.a.toLowerCase()) {
            feedbackBox.className = 'feedback correct';
            feedbackBox.innerText = isReviewWrongMode ? 'Jawaban Anda Benar Sekarang!' : 'Jawaban Anda Benar!';
        } else {
            feedbackBox.className = 'feedback incorrect';
            feedbackBox.innerText = `Jawaban Anda Salah. Jawaban Benar: (${item.a.toUpperCase()})`;
        }
    } else if (isReviewWrongMode) {
        feedbackBox.style.display = 'block';
        feedbackBox.className = 'feedback incorrect';
        feedbackBox.innerText = '⚠️ Belum dijawab';
    }

    if (isReviewWrongMode) {
        document.getElementById('prev-btn').disabled = reviewCurrentIdx === 0;
        document.getElementById('next-btn').disabled = reviewCurrentIdx === wrongOrUnansweredIndicesList.length - 1;
    } else {
        document.getElementById('prev-btn').disabled = currentIndex === 0;
        document.getElementById('next-btn').disabled = currentIndex === quizData.length - 1;
    }
    updateStats();
    if (!isReviewWrongMode) saveState();
}
function navigate(direction) {
    if (isReviewWrongMode) {
        reviewCurrentIdx += direction;
        if (reviewCurrentIdx < 0) reviewCurrentIdx = 0;
        if (reviewCurrentIdx >= wrongOrUnansweredIndicesList.length) reviewCurrentIdx = wrongOrUnansweredIndicesList.length - 1;
    } else {
        currentIndex += direction;
        if (currentIndex < 0) currentIndex = 0;
        if (currentIndex >= quizData.length) currentIndex = quizData.length - 1;
    }
    loadQuestion();
}
function jumpToQuestion() {
    if (isReviewWrongMode) return;
    const val = parseInt(document.getElementById('jump-no').value);
    if (val >= 1 && val <= quizData.length) { currentIndex = val - 1; loadQuestion(); }
    else alert(`Masukkan nomor soal antara 1 sampai ${quizData.length}.`);
}
function showFinalScoreModal() {
    let scoreCount = 0, wrongOrUnansweredCount = 0;
    userAnswers.forEach((ans, idx) => {
        if (ans !== null && ans === quizData[idx].a.toLowerCase()) scoreCount++;
        else wrongOrUnansweredCount++;
    });
    const percent = Math.round((scoreCount / quizData.length) * 100);
    document.getElementById('modal-correct-score').innerText = scoreCount;
    document.getElementById('modal-wrong-score').innerText = wrongOrUnansweredCount;
    document.getElementById('modal-percentage').innerText = `${percent}%`;
    document.getElementById('score-modal').style.display = 'flex';
}
function closeModal() { document.getElementById('score-modal').style.display = 'none'; }
function startReviewWrongMode() {
    wrongOrUnansweredIndicesList = [];
    userAnswers.forEach((ans, idx) => { if (ans === null || ans !== quizData[idx].a.toLowerCase()) wrongOrUnansweredIndicesList.push(idx); });
    if (wrongOrUnansweredIndicesList.length === 0) { alert("Semua soal sudah dijawab dengan benar!"); return; }
    isReviewWrongMode = true; reviewCurrentIdx = 0;
    document.getElementById('review-banner').classList.add('active');
    document.getElementById('jump-wrapper').style.display = 'none';
    document.getElementById('progress-label').innerText = 'Progres Sesi Review';
    loadQuestion();
}
function exitReviewMode() {
    isReviewWrongMode = false;
    document.getElementById('review-banner').classList.remove('active');
    document.getElementById('jump-wrapper').style.display = 'flex';
    document.getElementById('progress-label').innerText = 'Progres Pengerjaan';
    loadQuestion();
}
function resetQuiz() {
    if (confirm("Ulangi kuis dari awal? Semua jawaban akan dihapus.")) {
        userAnswers = new Array(quizData.length).fill(null);
        currentIndex = 0; isReviewWrongMode = false;
        document.getElementById('review-banner').classList.remove('active');
        document.getElementById('jump-wrapper').style.display = 'flex';
        document.getElementById('progress-label').innerText = 'Progres Pengerjaan';
        localStorage.removeItem('ssw_quiz_answers_full');
        localStorage.removeItem('ssw_quiz_index_full');
        loadQuestion();
    }
}
document.getElementById('total-count').innerText = quizData.length;
document.getElementById('total-subtitle').innerText = `Kumpulan Soal ASAT Dokkai (Total Soal: ${quizData.length})`;
const jumpInput = document.getElementById('jump-no');
jumpInput.max = quizData.length; jumpInput.placeholder = `1-${quizData.length}`;
loadSavedState();
loadQuestion();
</script>
</body>
